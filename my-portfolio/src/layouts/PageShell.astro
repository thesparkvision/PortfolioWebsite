---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

const defaultMainClass = 'mx-auto flex w-full max-w-6xl flex-1 flex-col gap-12 px-4 py-4 pb-10! sm:px-8 lg:px-12'
const { mainClass = defaultMainClass } = Astro.props
---

<div class="flex min-h-screen flex-col bg-[var(--color-background)]">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-[var(--color-primary)] focus:px-4 focus:py-2 focus:text-white">Skip to main content</a>
  <Header />
  <main id="main-content" class={mainClass}>
    <slot />
  </main>
  <Footer />
</div>
