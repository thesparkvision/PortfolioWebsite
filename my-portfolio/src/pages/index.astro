---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageShell from '../layouts/PageShell.astro'
import HomeIntro from '../components/HomeIntro.astro'
import FeaturedProjects from '../components/FeaturedProjects.astro'
import projects from '../data/projects.json'

const featuredProjects = projects.filter((project) => project.showInHomePage)
---

<BaseLayout title="Aman Pandya | Home" description="Portfolio of Aman Pandya">
  <PageShell>
    <HomeIntro />
    <FeaturedProjects projects={featuredProjects} />
  </PageShell>
</BaseLayout>
