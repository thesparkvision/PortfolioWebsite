---
import { resumeURL } from '../site.js'
---

<section id="intro" class="home-intro">
  <div>
    <h1 class="home-intro__heading">Full-stack software engineer</h1>
    <p class="home-intro__lead">
      I'm a Software Development Engineer 2 at <a class="content-link" href="https://agrichain.com/"
        >AgriChain</a
      >, building reliable, data-heavy software with Python, Django, React, and AWS.
    </p>
  </div>
  <div class="home-intro__resume">
    <a
      href={resumeURL}
      id="view-resume-btn"
      target="_blank"
      rel="noopener noreferrer"
      class="resume-button">View resume <span aria-hidden="true">↗</span></a
    >
  </div>
</section>
