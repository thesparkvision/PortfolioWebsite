---
import githubIcon from '../assets/github.svg?url'
import linkedinIcon from '../assets/linkedin.svg?url'
import peerlistIcon from '../assets/peerlist.svg?url'
import twitterIcon from '../assets/twitter.svg?url'
import gmailIcon from '../assets/gmail.svg?url'
import calendlyIcon from '../assets/calendly.svg?url'

const socials = [
  { url: 'https://github.com/thesparkvision', icon: githubIcon, altText: 'Github logo' },
  { url: 'https://www.linkedin.com/in/amanpandya/', icon: linkedinIcon, altText: 'Linkedin logo' },
  { url: 'https://peerlist.io/amanpandya828', icon: peerlistIcon, altText: 'Peerlist logo' },
  { url: 'https://twitter.com/sherlockd828', icon: twitterIcon, altText: 'Twitter logo' },
  { url: 'mailto:ampandya712@gmail.com', icon: gmailIcon, altText: 'Gmail logo' },
  {
    url: 'https://calendly.com/amanpandya712/30min',
    icon: calendlyIcon,
    altText: 'Calendly representation',
  },
]
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <ul class="social-list">
      {
        socials.map((social) => (
          <li>
            <a
              href={social.url}
              aria-label={social.altText}
              target={social.url.startsWith('http') ? '_blank' : undefined}
              rel={social.url.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="social-link"
            >
              <img class="social-icon" src={social.icon} alt={social.altText} />
            </a>
          </li>
        ))
      }
    </ul>
    <div>&copy; {new Date().getFullYear()} Aman Pandya. Made with fun.</div>
  </div>
</footer>
