---
const { projects } = Astro.props
---

{
  projects.length > 0 && (
    <section id="selected-work" aria-labelledby="selected-work-heading">
      <h2 id="selected-work-heading" class="section-heading">
        Featured project
      </h2>
      <ul class="content-list">
        {projects.map((project) => (
          <li class="project-row project-row--featured">
            <div class="project-meta">
              <span class="project-name">{project.title}</span>
              <a
                class="content-link project-link"
                href={project.githubLink}
                target="_blank"
                rel="noopener noreferrer"
              >
                View on GitHub <span aria-hidden="true">↗</span>
                <span class="sr-only">: {project.title}</span>
              </a>
            </div>
            <p class="body-copy">{project.description}</p>
          </li>
        ))}
      </ul>
    </section>
  )
}
