{
  "name": "my-portfolio",
  "private": true,
  "packageManager": "bun@1.4.0",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "bun run format:check && bun run lint:css && astro build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && bun run lint:css",
    "lint:css": "stylelint \"src/**/*.css\"",
    "preview": "astro preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "astro": "^7.2.9",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^38.0.0"
  }
}
